# Reference parameters applied via Patroni bootstrap.dcs.postgresql.parameters
wal_level = replica
hot_standby = on
max_wal_senders = 10
max_replication_slots = 10
wal_keep_size = 128MB
max_slot_wal_keep_size = 1GB
hot_standby_feedback = on
archive_mode = on
archive_command = 'wal-g wal-push %p'
archive_timeout = 60s
