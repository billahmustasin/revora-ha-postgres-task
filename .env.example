# Template only — no real credentials.
# On first make up / make secrets, gen-secrets copies this to .env (gitignored)
# and replaces every <set-me> with a random value.
#
# Or: cp .env.example .env  then edit, then make secrets

SUPERUSER_PASSWORD=<set-me>
REPLICATOR_PASSWORD=<set-me>
ADMIN_PASSWORD=<set-me>
APP_PASSWORD=<set-me>
MINIO_ROOT_USER=<set-me>
MINIO_ROOT_PASSWORD=<set-me>

CLUSTER_NAME=postgres-ha
IMAGE=postgres-patroni:16
